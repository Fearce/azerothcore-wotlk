# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================
.cache
compile_commands.json

# WowPs: track our party-of-5 module that lives inside modules/.
!/modules/mod-party-of-5/
!/modules/mod-party-of-5/**

# WowPs: vendor the ALE (Eluna) engine + MythicPlus integration. Track the engine
# source, the MythicPlus Lua/SQL/AIO, and the deploy docs — but NOT the ~12MB of
# binary client patch assets (textures/DBCs); fetch those from
# github.com/huptiq/MythicPlus (Data/Client) when building the client MPQ patch.
!/modules/mod-ale/
!/modules/mod-ale/**
/modules/mod-ale/MythicPlus/Data/Client/
# The blanket un-ignore above also re-includes build output dropped inside the
# vendored tree, so a `git add -A` would commit compiler debug databases.
/modules/mod-ale/**/*.pdb
/modules/mod-ale/**/*.obj
/modules/mod-ale/**/*.ilk

# WowPs: vendor mod-playerbots (our patched fork) into the server repo.
!/modules/mod-playerbots/
!/modules/mod-playerbots/**