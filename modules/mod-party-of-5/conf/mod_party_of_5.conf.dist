#
# WowPs Party-of-5 module configuration
#

[worldserver]

########################################
# Party-of-5 module configuration
########################################
#
#    WowPsParty.Enable
#        Description: Enable the party-of-5 mod (GW1-hero / DAI-henchman style party).
#                     When enabled, each account owns 5 characters that travel as a party;
#                     the player controls one at a time via F1-F5 swap.
#        Default:     1 - Enabled
#                     0 - Disabled (module compiled in but inactive)
#

WowPsParty.Enable = 1

#
#    WowPsParty.LogVerbose
#        Description: Emit verbose lifecycle log lines (per-player login banner, slot lookups,
#                     swap dispatches, AI loadout reloads). Useful during development; turn off
#                     in production to keep the log volume manageable.
#        Default:     1 - Verbose
#                     0 - Quiet
#

WowPsParty.LogVerbose = 1

#
#    WowPsParty.LfgAutofill.Enable
#        Description: When a SOLO player queues the Dungeon Finder, offer (via a popup)
#                     to instantly fill their party to 1 tank / 1 healer / 3 dps with
#                     hired bots for the summed henchman cost, discounted 15%. The
#                     player's slot is set by the LFG role they queued as. Optional —
#                     declining queues them with random players as normal. Players can
#                     opt out per-account ("Don't ask again" / .party lfgfill off).
#        Default:     1 - Offer enabled
#                     0 - Never offer
#

WowPsParty.LfgAutofill.Enable = 1
